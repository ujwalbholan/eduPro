# Local host development (pnpm dev)
DATABASE_URL=postgresql://identity_user:identity_password@localhost:5435/identity_db?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
PORT=4000
NODE_ENV=development
JWT_ISSUER=identity-service
JWT_AUDIENCE=education-api

